#!/usr/bin/env bash
set -euo pipefail

STATE_DIR="${AGENT_LLM_HOME:-${HOME}/.agent-llm}"
PID_FILE="${STATE_DIR}/gateway.pid"

if [[ ! -f "${PID_FILE}" ]]; then
  echo "agent-llm gateway is not running"
  exit 0
fi

PID="$(cat "${PID_FILE}")"
if kill -0 "${PID}" 2>/dev/null; then
  kill "${PID}"
  echo "stopped agent-llm gateway pid ${PID}"
else
  echo "agent-llm gateway pid ${PID} was not running"
fi

rm -f "${PID_FILE}"
